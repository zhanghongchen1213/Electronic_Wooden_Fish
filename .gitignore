# 本地环境变量覆盖（不提交）
*.local

# 日志目录
logs/*
!logs/.gitkeep

# Node.js
node_modules/
.npm-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.pnpm-debug.log*

# 构建产物
dist/
build/
*.jar
*.war
target/
_bmad

# IDE
.idea/
.vscode/
*.swp
*.swo
.cursor
.DS_Store
tmp/*   
docs/hardware/芯片手册
docs/hardware/参考原理图

# 忽略 .claude / .agents 其余内容，只跟踪 epic autopilot
# 父目录被整段忽略时，Git 不会进入子目录，否定规则必须逐级放开
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/bmad-epic-autopilot/
!.claude/skills/bmad-code-review/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/bmad-epic-autopilot/
!.agents/skills/bmad-code-review/
_bmad-output/implementation-artifacts/.autopilot
docs/embedded/build_records
docs/embedded/hardware_test_records