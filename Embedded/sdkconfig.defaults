# Story 1.2: ESP32-S3 CO5300/CST9217 LVGL8 fixed configuration
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=73728
# SquareLine 主界面的对象规模超过 LVGL 固定内存池，改用可回退到 PSRAM 的标准堆。
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_CUSTOM_INCLUDE="stdlib.h"
CONFIG_LV_MEMCPY_MEMSET_STD=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_DISP_DEF_REFR_PERIOD=8
CONFIG_LV_INDEV_DEF_READ_PERIOD=10
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPI_MASTER_IN_IRAM=y

# ESP-IDF v5.5.4 ESP32-S3 动态调频与自动 light sleep
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
# 板级无 32.768 kHz 晶振，RTC 保持内部 RC。
CONFIG_RTC_CLK_SRC_INT_RC=y

# 16 MB 当前无 OTA 的紧凑自定义分区与 SPIFFS 镜像配置
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIFFS_USE_MAGIC=y
CONFIG_SPIFFS_USE_MAGIC_LENGTH=y

# BOOT0 语音只打包中文 MultiNet5 Q8；不实例化 AFE，且不打包 WakeNet、英文、NSNet、VADNet 模型。
CONFIG_SR_MN_CN_MULTINET5_RECOGNITION_QUANT8=y
CONFIG_SR_MN_EN_NONE=y
CONFIG_MODEL_IN_FLASH=y

# ESP32-S3 原生 USB Serial/JTAG 独占应用日志，释放 GPIO43/GPIO44 给 ML307R UART2
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# USB 主机连接期间禁止自动 light sleep，避免调试串口失联；拔线后不影响电池态自动休眠。
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

# Story 2.1: ESP-IDF v5.5.4 ESP32-S3 NimBLE Central/Observer 单连接配置
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=72
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
# 本机只需要扫描与单连接两个 controller activity，避免为未使用实例长期占用内部 DMA 内存。
CONFIG_BT_CTRL_BLE_MAX_ACT=2
# GATT 与连接参数更新可能并发发送，启动时预留 ACL TX 缓冲，禁止链路建立后临时争抢内部 DMA 堆。
CONFIG_BT_CTRL_BLE_STATIC_ACL_TX_BUF_NB=4
# NimBLE Host 动态对象使用 PSRAM，避免与 CO5300 DMA、BT controller 争用内部 DRAM。
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# BLE 连接态使用主晶振作为低功耗时钟，并在 light sleep 期间保持主晶振供电。
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
# PHY 空闲时关闭 Wi-Fi/Bluetooth MAC 与基带，以约 2 KB BLE RAM 换取更低休眠功耗。
CONFIG_ESP_PHY_MAC_BB_PD=y
